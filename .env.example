# Copie para .env na raiz (nao commite segredos reais).
# Obrigatorio para docker compose up (POSTGRES_PASSWORD e LOJAPP_JWT_SECRET).
# Portas canônicas: API 8081 · FE 5173 · PG host 5433 · Redis host 6381
# Ver: Desktop/Agentes/PORTFOLIO-PORTS.md
# WSL antes de mvn: set -a && source .env && set +a
#
# Gerar segredos fortes (exemplos):
#   Linux/macOS: openssl rand -base64 32
#   PowerShell:  -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 32 | % {[char]$_})

# PostgreSQL - alinhar POSTGRES_PASSWORD com SPRING_DATASOURCE_PASSWORD no mesmo .env
# docker-compose.yml (dev) usa loja_db / loja_user · host 5433
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/loja_db
SPRING_DATASOURCE_USERNAME=loja_user
SPRING_DATASOURCE_PASSWORD=
POSTGRES_PASSWORD=

# Redis (rate limit distribuido; obrigatorio se LOJAPP_RATE_LIMIT_MODE=redis)
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6381

# JWT - minimo ~32 caracteres; obrigatorio (ver ProductionSecurityConfig).
LOJAPP_JWT_SECRET=

# CORS - origens do frontend, separadas por virgula
LOJAPP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Registo publico - default seguro e false. Em dev local:
# LOJAPP_REGISTRATION_ENABLED=true

# Cookie de refresh - em producao com HTTPS: LOJAPP_AUTH_REFRESH_COOKIE_SECURE=true

# Opcional: LOJAPP_RATE_LIMIT_MODE=memory|redis (em docker-compose local usa redis)

# Opcional frontend (Vite)
# VITE_API_BASE=http://localhost:8081
# LOJAPP_API_PROXY=http://localhost:8081
